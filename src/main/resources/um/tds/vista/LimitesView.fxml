<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="um.tds.vista.LimitesController">

    <top>
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Límite (€):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtLimite" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Categoría:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboCategoria" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Periodo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboPeriodo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Button fx:id="btnCrearLimite" text="Crear alerta"
                    GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>
    </top>
    

    <center>
        <TableView fx:id="tablaLimites">
            <columns>
                <TableColumn text="Categoría" fx:id="colCategoria"/>
                <TableColumn text="Periodo" fx:id="colPeriodo"/>
                <TableColumn text="Límite (€)" fx:id="colLimite"/>
                <TableColumn text="Activo" fx:id="colActivo"/>
            </columns>
        </TableView>
    </center>

</BorderPane>
